# Copy to .env.local to talk to a real gateway instead of the built-in MSW mocks.
# VITE_API_MOCKING=off
# VITE_API_BASE_URL=http://localhost:9191
# VITE_OIDC_AUTHORITY=http://localhost:7080/realms/assay
# VITE_OIDC_CLIENT_ID=assay-spa
# The demo accounts' shared password. Public by design (see the API contract), not a secret.
# VITE_DEMO_PASSWORD=assay-demo
